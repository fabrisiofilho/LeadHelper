{
  "name": "leadhelper",
  "version": "1.0.0",
  "description": "Aplicação de gestão de equipes para Tech Leads desenvolvida em Electron.",
  "main": "./out/main/index.js",
  "homepage": "./",
  "author": {
    "name": "LeadHelper"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:node": "eslint --cache src/main src/preload src/shared",
    "lint:web": "eslint --cache src/renderer",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "dev-watch": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "rebuild:sqlite32": "electron-rebuild -f --arch=ia32 -w better-sqlite3",
    "rebuild:sqlite64": "electron-rebuild -f --arch=x64 -w better-sqlite3",
    "build:unpack": "npm run build && npm run rebuild:sqlite && electron-builder --dir",
    "build:win": "npm run build && npm run rebuild:sqlite && electron-builder --win",
    "build:win:dev": "copy .env.dev.example .env && npm run build:win",
    "build:win:hml": "copy .env.hml.example .env && npm run build:win",
    "build:win:tre": "copy .env.tre.example .env && npm run build:win",
    "build:win32": "npm run build && npm run rebuild:sqlite32 && electron-builder --win --ia32",
    "build:win64": "npm run build && npm run rebuild:sqlite64 && electron-builder --win --x64",
    "build:multi-win": "npm run build && npm run rebuild:sqlite64 && npm run rebuild:sqlite32 && electron-builder --win --x64 --ia32",
    "build:linux": "npm run build && npm run rebuild:sqlite && electron-builder --linux",
    "build:mac": "npm run build && npm run rebuild:sqlite && electron-builder --mac",
    "publish": "npm run build && npm run rebuild:sqlite && electron-builder --win --publish always",
    "publish:win": "npm run build && npm run rebuild:sqlite && electron-builder --win --publish always",
    "publish:mac": "npm run build && npm run rebuild:sqlite && electron-builder --mac --publish always",
    "publish:linux": "npm run build && npm run rebuild:sqlite && electron-builder --linux --publish always",
    "migration:create": "npx ts-node src/main/infrastructure/database/scripts/migration-cli.ts create",
    "migration:status": "npx ts-node src/main/infrastructure/database/scripts/migration-cli.ts status",
    "migration:help": "npx ts-node src/main/infrastructure/database/scripts/migration-cli.ts help"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/styled-engine-sc": "^7.3.5",
    "@mui/x-date-pickers": "^8.19.0",
    "@reduxjs/toolkit": "^2.10.1",
    "@types/bcryptjs": "^2.4.6",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "call-bind": "^1.0.8",
    "call-bind-apply-helpers": "^1.0.2",
    "chalk": "^4.1.2",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.3.1",
    "dotenv": "^16.4.5",
    "electron-toolkit": "^1.0.24",
    "electron-updater": "^6.3.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.552.0",
    "marked": "^17.0.3",
    "notistack": "^3.0.2",
    "polished": "^4.3.1",
    "react-hook-form": "^7.66.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.7.0",
    "reflect-metadata": "^0.2.2",
    "styled-components": "^6.1.19",
    "turndown": "^7.2.2",
    "typeorm": "^0.3.27",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@swc/core": "^1.15.2",
    "@swc/helpers": "^0.5.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.3",
    "baseline-browser-mapping": "^2.9.18",
    "electron": "^38.7.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^4.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "vite": "^7.1.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18"
  }
}
